DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
FRED_API_KEY=replace-with-your-fred-api-key

# The Linux host gateway works when Temporal publishes port 7233 on this server.
TEMPORAL_ADDRESS=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=finance-tools
HTTP_TIMEOUT_SECONDS=20

# Kalshi new-market monitor. Remove categories you do not want reported.
KALSHI_API_KEY_ID=
# Base64-encode the complete PEM private key, including its header and footer.
KALSHI_PRIVATE_KEY_BASE64=
KALSHI_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me
KALSHI_CATEGORY_WHITELIST=Climate and Weather,Commodities,Companies,Crypto,Economics,Elections,Entertainment,Financials,Mentions,Politics,Science and Technology,Social,Sports
KALSHI_DISCORD_BATCH_DELAY_SECONDS=1
KALSHI_REQUESTS_PER_SECOND=10
KALSHI_EVENT_RESOLUTION_TIMEOUT_SECONDS=60
# Set to 0 to disable. Decimal values are supported.
KALSHI_MIN_MARKET_DURATION_DAYS=0

# Crypto carry digest (CME BTC/ETH futures vs Coinbase spot).
CRYPTO_CARRY_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace/me

# ThetaData symbol snapshot. The worker container reaches Garage and Quack
# through the host gateway. Iceberg SQL runs on the DuckDB server, so
# ICEBERG_CATALOG_URI must be reachable from that server.
THETADATA_API_KEY=
ETL_PIPELINE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/replace/me
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_S3_ENDPOINT=http://host.docker.internal:3900
GARAGE_S3_REGION=garage
QUACK_URI=quack:host.docker.internal:9494
QUACK_TOKEN=
ICEBERG_CATALOG_URI=http://192.168.0.20:8181/catalog

# Shared ThetaData gate. Compose sets the worker to redis://redis:6379/0.
# Redis listens on the compose network only.
REDIS_URL=redis://redis:6379/0
THETADATA_MAX_CONCURRENT=2
THETADATA_REQUESTS_PER_MINUTE=0
THETADATA_LEASE_SECONDS=900
THETADATA_JOB_PRIORITIES=ThetaDataOptionDataWorkflow=10,ThetaDataSecuritiesWorkflow=20,ThetaDataOptionBackfillWorkflow=100
THETADATA_OPTION_BATCH_SIZE=40
THETADATA_OPTION_MIN_ROWS=1000
